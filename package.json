{
  "name": "@embodot/vibeguard",
  "version": "0.1.1",
  "description": "Security guard for AI coding agents - detects secrets, blocks dangerous operations",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "vibeguard": "bin/vibeguard.js"
  },
  "files": [
    "bin",
    "dist",
    "hooks",
    "patterns.toml",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp -r src/dashboard/public dist/dashboard/",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard": "node dist/dashboard/server.js",
    "hook": "node dist/hooks/pre-tool-use.js",
    "release:dry-run": "npm publish --dry-run --access public"
  },
  "keywords": [
    "security",
    "secrets",
    "coding-agent",
    "claude-code",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dadwadw233/VibeGuard"
  },
  "homepage": "https://github.com/dadwadw233/VibeGuard#readme",
  "bugs": {
    "url": "https://github.com/dadwadw233/VibeGuard/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  }
}
